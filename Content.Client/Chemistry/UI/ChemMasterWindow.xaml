<controls:FancyWindow xmlns="https://spacestation14.io"
                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                MinSize="980 700"
                Title="{Loc 'chem-master-bound-user-interface-title'}">
    <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="6">

        <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="6">

            <!-- A: input container -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="1" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'chem-master-window-container-label'}" />
                    <Control HorizontalExpand="True" />
                    <Button MinSize="70 0" Name="InputEjectButton" Access="Public" Text="{Loc 'chem-master-window-eject-button'}" />
                </BoxContainer>
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="InputContainerInfo" Orientation="Vertical" Margin="4" HorizontalExpand="True">
                            <Label Text="{Loc 'chem-master-window-no-container-loaded-text'}" />
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <!-- B: buffer -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="1.1" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'chem-master-window-buffer-text'}" />
                    <Control HorizontalExpand="True" />
                    <Button MinSize="70 0" Name="BufferSortButton" Access="Public" Text="{Loc 'chem-master-window-sort-type-none'}" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button HorizontalExpand="True" Name="BufferTransferButton" Access="Public" Text="{Loc 'chem-master-window-transfer-button'}" ToggleMode="True" StyleClasses="OpenRight" />
                    <Button HorizontalExpand="True" Name="BufferDiscardButton" Access="Public" Text="{Loc 'chem-master-window-discard-button'}" ToggleMode="True" StyleClasses="OpenLeft" />
                </BoxContainer>
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="BufferInfo" Orientation="Vertical" Margin="4" HorizontalExpand="True">
                            <Label Text="{Loc 'chem-master-window-buffer-empty-text'}" />
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>
            </BoxContainer>

            <!-- C: output and packaging -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SizeFlagsStretchRatio="1.4" SeparationOverride="4">
                <BoxContainer Orientation="Horizontal">
                    <Label Text="{Loc 'chem-master-window-container-label'}" />
                    <Control HorizontalExpand="True" />
                    <Button MinSize="70 0" Name="OutputEjectButton" Access="Public" Text="{Loc 'chem-master-window-eject-button'}" />
                </BoxContainer>
                <PanelContainer VerticalExpand="True">
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
                        <BoxContainer Name="OutputContainerInfo" Orientation="Vertical" Margin="4" HorizontalExpand="True">
                            <Label Text="{Loc 'chem-master-window-no-container-loaded-text'}" />
                        </BoxContainer>
                    </ScrollContainer>
                </PanelContainer>

                <PanelContainer>
                    <PanelContainer.PanelOverride>
                        <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
                    </PanelContainer.PanelOverride>
                    <BoxContainer Orientation="Vertical" Margin="4" HorizontalExpand="True" SeparationOverride="4">

                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'chem-master-output-source'}" StyleClasses="LabelSecondaryColor" Margin="0 0 5 0"/>
                            <Button HorizontalExpand="True" Name="OutputBufferDraw" Access="Public" Text="{Loc 'chem-master-output-buffer-draw'}" ToggleMode="True" StyleClasses="OpenRight" />
                            <Button HorizontalExpand="True" Name="OutputBeakerDraw" Access="Public" Text="{Loc 'chem-master-output-beaker-draw'}" ToggleMode="True" StyleClasses="OpenLeft" />
                            <Control MinSize="6 0" />
                            <Label Name="DrawSource"/>
                            <Label Name="BufferCurrentVolume" StyleClasses="LabelSecondaryColor" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'chem-master-current-text-label'}" />
                            <Control MinSize="6 0" />
                            <LineEdit Name="LabelLineEdit" HorizontalExpand="True" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'chem-master-window-pill-type-label'}"/>
                            <Control HorizontalExpand="True" />
                        </BoxContainer>
                        <GridContainer Name="Grid" Columns="10" HorizontalAlignment="Center">
                            <!-- Pills type buttons are generated in the code -->
                        </GridContainer>

                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'chem-master-window-pills-label'}" />
                            <Control HorizontalExpand="True" />
                            <Label Name="PillNumberLabel" Text="{Loc 'chem-master-window-pills-number-label'}" Margin="5 0 0 0" StyleClasses="LabelWeak" />
                            <SpinBox MinSize="80 0" Name="PillNumber" Access="Public" Value="0" />
                            <Label Name="PillDoseLabel" Text="{Loc 'chem-master-window-dose-label'}" Margin="5 0 0 0" StyleClasses="LabelWeak" />
                            <SpinBox MinSize="80 0" Name="PillDosage" Access="Public" Value="1" />
                            <Button MinSize="70 0" Name="CreatePillButton" Access="Public" Text="{Loc 'chem-master-window-create-button'}" />
                        </BoxContainer>

                        <BoxContainer Orientation="Horizontal">
                            <Label Text="{Loc 'chem-master-window-bottles-label'}" />
                            <Control HorizontalExpand="True" />
                            <Label Name="BottleDoseLabel" Text="{Loc 'chem-master-window-dose-label'}" Margin="5 0 0 0" StyleClasses="LabelWeak" />
                            <SpinBox MinSize="80 0" Name="BottleDosage" Access="Public" Value="0" />
                            <Button MinSize="70 0" Name="CreateBottleButton" Access="Public" Text="{Loc 'chem-master-window-create-button'}" />
                        </BoxContainer>

                        <Label Name="PackagingHint" StyleClasses="LabelSubText" Visible="False" />

                        <Button Name="RepeatButton" Access="Public" Disabled="True" Text="{Loc 'chem-master-window-repeat-button'}" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>

        <!-- D: one shared transfer amount, instead of ten buttons on every row -->
        <PanelContainer>
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" Margin="4" SeparationOverride="4">
                <Label Text="{Loc 'chem-master-window-amount-label'}" />
                <Control MinSize="6 0" />
                <BoxContainer Name="AmountSelector" Orientation="Horizontal" HorizontalExpand="True" />
            </BoxContainer>
        </PanelContainer>

    </BoxContainer>
</controls:FancyWindow>
