<readyCheck:ReadyCheckPDAFragment xmlns:readyCheck="clr-namespace:Content.Client._FinalStand.ReadyCheck"
                                  xmlns="https://spacestation14.io" Margin="2">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

        <Label Name="HeaderLabel" Text="READY CHECK" HorizontalAlignment="Center" Margin="0 4 0 4" />

        <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6" />

        <!-- Shown for non-command roles -->
        <Label Name="AccessDeniedLabel" Text="Command access required."
               HorizontalAlignment="Center" Modulate="#FF8888" Visible="False" />

        <!-- Dept status grid — shown for all command roles -->
        <BoxContainer Name="DeptStatusContainer" Orientation="Vertical" Margin="0 0 0 6" />

        <PanelContainer StyleClasses="LowDivider" Name="ButtonDivider" Margin="0 4 0 4" Visible="False" />

        <!-- Buttons — shown only for non-captain command roles -->
        <BoxContainer Name="ButtonContainer" Orientation="Horizontal" Visible="False">
            <Button Name="ReadyButton" Text="READY" HorizontalExpand="True" Margin="2" />
            <Button Name="NotReadyButton" Text="NOT READY" HorizontalExpand="True" Margin="2" />
        </BoxContainer>

    </BoxContainer>
</readyCheck:ReadyCheckPDAFragment>
