<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Perk Shop"
                      Resizable="False"
                      SetSize="860 640"
                      MinSize="860 640">
    <TabContainer Name="ShopTabs" VerticalExpand="True">

        <!-- ═══════════════════ TAB 0: PERKS ═══════════════════ -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Margin="8">

            <!-- LEFT: Info + Slots + Loadouts -->
            <ScrollContainer SetWidth="270" VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" SetWidth="260" Margin="10 0 0 0">

                <!-- Selected perk icon (cat bg → level bg → icon); anchors set in constructor -->
                <LayoutContainer Name="SelectedIconContainer" SetWidth="64" SetHeight="64" Margin="0 0 0 6">
                    <PanelContainer Name="SelectedIconCatBg" />
                    <PanelContainer Name="SelectedIconLevelBg" />
                    <TextureRect Name="SelectedPerkIcon" Stretch="KeepAspectCentered" />
                </LayoutContainer>

                <!-- AP display (prominent, always visible) -->
                <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
                    <Label Text="PP: " StyleClasses="FSCurrency" />
                    <Label Name="ApLabel" Text="0" StyleClasses="FSCurrency" />
                </BoxContainer>

                <!-- Name + Level + Category -->
                <Label Name="SelectedNameLabel" Text="—" StyleClasses="LabelHeading" Margin="0 0 0 2" />
                <Label Name="SelectedLevelLabel" Text="Level 0 / 4" StyleClasses="FSMuted" Margin="0 0 0 2" />
                <Label Name="SelectedCategoryLabel" Text="" Margin="0 0 0 4" />

                <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6" />

                <!-- Active slots -->
                <Label Text="ACTIVE SLOTS" StyleClasses="FSSectionHeader" Margin="0 0 0 4" />
                <BoxContainer Name="SlotsRow" Orientation="Horizontal" Margin="0 0 0 6" />

                <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6" />

                <!-- Description + effects -->
                <RichTextLabel Name="SelectedDescLabel" HorizontalExpand="True" Margin="0 0 0 4" />
                <BoxContainer Name="LevelEffectsBox" Orientation="Vertical" Margin="0 0 0 8" />

                <Label Name="SelectedCostLabel" Text="" StyleClasses="FSCurrency" Margin="0 0 0 6" />

                <!-- Action buttons -->
                <Button Name="UpgradeButton" Text="Unlock / Upgrade" Disabled="True" Margin="0 0 0 3" />
                <Button Name="EquipButton" Text="Equip to First Open Slot" Disabled="True" Margin="0 0 0 3" />
                <Button Name="UnequipButton" Text="Unequip from Slot" Disabled="True" Margin="0 0 0 3" />
                <Button Name="RespecButton" Text="Respec (Refund All)" StyleClasses="FSNegative" Margin="0 0 0 6" />

                <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6" />

                <!-- Loadouts -->
                <Label Text="LOADOUTS" StyleClasses="FSSectionHeader" Margin="0 0 0 4" />
                <BoxContainer Orientation="Horizontal" Margin="0 0 0 3">
                    <Button Name="SaveLoadout0" Text="Save 1" HorizontalExpand="True" Margin="0 0 2 0" />
                    <Button Name="LoadLoadout0" Text="Load 1" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 0 0 3">
                    <Button Name="SaveLoadout1" Text="Save 2" HorizontalExpand="True" Margin="0 0 2 0" />
                    <Button Name="LoadLoadout1" Text="Load 2" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="SaveLoadout2" Text="Save 3" HorizontalExpand="True" Margin="0 0 2 0" />
                    <Button Name="LoadLoadout2" Text="Load 3" HorizontalExpand="True" />
                </BoxContainer>

            </BoxContainer>
            </ScrollContainer>

            <!-- Vertical separator -->
            <PanelContainer StyleClasses="LowDivider" Margin="4 0" />

            <!-- RIGHT: Filter + Search + Icon grid -->
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

                <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
                    <Button Name="FilterAll"    Text="All"     HorizontalExpand="True" ToggleMode="True" Margin="0 0 2 0" />
                    <Button Name="FilterRed"    Text="Offense" HorizontalExpand="True" ToggleMode="True" Margin="0 0 2 0" />
                    <Button Name="FilterBlue"   Text="Defense" HorizontalExpand="True" ToggleMode="True" Margin="0 0 2 0" />
                    <Button Name="FilterGreen"  Text="Utility" HorizontalExpand="True" ToggleMode="True" Margin="0 0 2 0" />
                    <Button Name="FilterYellow" Text="Economy" HorizontalExpand="True" ToggleMode="True" Margin="0 0 2 0" />
                    <Button Name="FilterPurple" Text="Hybrid"  HorizontalExpand="True" ToggleMode="True" />
                </BoxContainer>

                <LineEdit Name="SearchBar" PlaceHolder="Search perks..." Margin="0 0 0 6" />

                <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="PerkGrid" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>

            </BoxContainer>

        </BoxContainer>

        <!-- ═══════════════════ TAB 1: PRESTIGE ═══════════════════ -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="16">

            <Label Name="PrestigeLevelLabel" Text="Prestige 0 — Level 1" StyleClasses="LabelHeading" Margin="0 0 0 8" />
            <Label Name="PrestigeXpBonusLabel" Text="Current XP Bonus: +0%" Margin="0 0 0 4" />
            <Label Name="PrestigeRequirementLabel" Text="Reach Level 50 to Prestige" StyleClasses="FSMuted" Margin="0 0 0 16" />
            <Button Name="PrestigeButton" Text="✦  PRESTIGE  ✦" Disabled="True" SetHeight="40" Margin="0 0 0 20" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 10" />

            <Label Text="PRESTIGE HISTORY" StyleClasses="FSSectionHeader" Margin="0 0 0 6" />
            <!-- // TODO(finalstand): populate prestige history -->
            <Label Name="PrestigeHistoryLabel" Text="No prestiges yet." StyleClasses="FSMuted" />

        </BoxContainer>

    </TabContainer>
</controls:FancyWindow>
