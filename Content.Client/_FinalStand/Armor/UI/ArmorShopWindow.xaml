<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Armor Vendor"
    MinWidth="580" MinHeight="400">

    <BoxContainer Orientation="Horizontal" Margin="8">

        <!-- LEFT: tier selection list -->
        <BoxContainer Orientation="Vertical" MinWidth="260" Margin="0 0 8 0">
            <Label Text="SELECT ARMOR" Modulate="#AAAAAA" Margin="0 0 0 6" />
            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="TierListContainer" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>

        <!-- vertical divider -->
        <PanelContainer StyleClasses="LowDivider" Margin="0 0 8 0" />

        <!-- RIGHT: selected tier stats + buy -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <Label Name="SelectedTierName" Text="—" StyleClasses="LabelHeading" Margin="0 0 0 4" />
            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 6" />
            <BoxContainer Name="StatsContainer" Orientation="Vertical" VerticalExpand="True" />
            <Button Name="BuyButton" Text="BUY" Disabled="True" Margin="0 8 0 0" />
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
