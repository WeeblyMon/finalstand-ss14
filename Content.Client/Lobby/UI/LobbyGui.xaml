<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <!-- Background: the lobby splash art (LobbyState sets .Texture from the selected lobbyBackground) -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" />
    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="0 0 0 0" SeparationOverride="2">
        <SplitContainer State="Auto" ResizeMode="NotResizable" HorizontalExpand="True" SplitWidth="0">
            <!-- LHS: only carries visible content in CharacterSetup mode; empty in the default lobby view -->
            <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4">
                <Control Access="Public" Name="DefaultState" VerticalExpand="True" />
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>
            <!-- RHS: the full lobby layout. Must be Stretch (not Right) so it fills the split box instead of
                 shrinking to its content width and leaving a gap on the left. No backdrop panel here so the
                 lobby splash art shows through around the cards. -->
            <PanelContainer Name="RightSide" Access="Public"
                            HorizontalExpand="True" VerticalExpand="True">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="0">
                    <!-- Solid black band from the top down to the divider (contains nav so it auto-aligns) -->
                    <PanelContainer StyleClasses="FSNavBar">
                        <BoxContainer Orientation="Vertical" SeparationOverride="0" Margin="14 12 14 0">
                    <!-- Nav row -->
                    <BoxContainer Name="HeaderContainer" Access="Public" Orientation="Horizontal" MinSize="0 36"
                                  SeparationOverride="4">
                            <!-- Single class: XAML StyleClasses doesn't split on spaces, so a two-class value
                                 would match neither selector and fall back to the generic grey button box. -->
                            <Button Name="NavLobbyButton" Text="LOBBY" StyleClasses="FSNavActive" />
                            <Button Name="NavRulesButton" Text="RULES" StyleClasses="FSNavTab" />
                            <Button Name="NavDiscordButton" Text="DISCORD" StyleClasses="FSNavTab" />
                            <Button Name="NavGuidebookButton" Text="GUIDEBOOK" StyleClasses="FSNavTab" />
                            <Button Name="NavChangelogButton" Text="CHANGELOG" StyleClasses="FSNavTab" />
                            <Control HorizontalExpand="True" MinSize="20 0" />
                            <Label Name="ServerName" Access="Public" StyleClasses="FSTitle" VAlign="Center" />
                            <Control HorizontalExpand="True" MinSize="20 0" />
                            <Button Name="AHelpButton" Access="Public" Text="AHELP" />
                            <vote:VoteCallMenuButton Name="CallVoteButton" />
                            <Button Name="OptionsButton" Access="Public" Text="OPTIONS" />
                            <Button Name="LeaveButton" Access="Public" Text="LEAVE"
                                    StyleClasses="FSLeaveButton" />
                    </BoxContainer>
                    <!-- Divider = bottom edge of the black band -->
                    <controls:HLine Color="#2E2E2E" Thickness="2" Margin="0 6 0 0" />
                        </BoxContainer>
                    </PanelContainer>
                    <!-- Faint black continuation (~5px, 20% opacity) just below the divider -->
                    <PanelContainer StyleClasses="FSTopFade" MinSize="0 5" />
                    <!-- Content below the top band, inset (black band above is full-bleed).
                         VerticalExpand so the cards fill the height instead of bunching at the top. -->
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                                  SeparationOverride="8" Margin="14 8 14 14">
                    <!-- Voting popups -->
                    <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                  Access="Public" HorizontalAlignment="Left" />
                    <!-- Status pill row: pill spans the first card's width, empty space fills the rest -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" Margin="0 0 0 4">
                        <PanelContainer StyleClasses="FSStatusPill" HorizontalExpand="True" SizeFlagsStretchRatio="1.15">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalAlignment="Center">
                                <TextureRect TexturePath="/Textures/Interface/Actions/eyeopen.png"
                                             Stretch="KeepAspectCentered" SetSize="18 18" VerticalAlignment="Center" />
                                <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                    Text="{Loc 'ui-lobby-observe-button'}"
                                                    StyleClasses="FSPillButton"
                                                    WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                <Label Text="|" StyleClasses="FSTextDim" VAlign="Center" />
                                <Label Name="StartTime" Access="Public" Align="Left" StyleClasses="FSTextDim"
                                       HorizontalExpand="True" VAlign="Center" Margin="6 0 0 0" />
                                <Label Text="•" StyleClasses="FSTextDim" VAlign="Center" />
                                <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                        StyleClasses="FSPillButton"
                                        Text="{Loc 'ui-lobby-ready-up-button'}" MinWidth="120" />
                            </BoxContainer>
                        </PanelContainer>
                        <Control HorizontalExpand="True" SizeFlagsStretchRatio="1.85" />
                    </BoxContainer>
                    <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" />
                    <!-- Three-card row (shortened so the bottom row grows to fill the freed space) -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True"
                                  VerticalExpand="True" SizeFlagsStretchRatio="1.35">
                        <!-- Server Info card -->
                        <PanelContainer StyleClasses="FSLobbyCard" HorizontalExpand="True" SizeFlagsStretchRatio="1.15">
                            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                    <TextureRect TexturePath="/Textures/_FinalStand/Interface/Lobby/lobby_info.png"
                                                 Stretch="KeepAspectCentered" SetSize="18 18" VerticalAlignment="Center" />
                                    <Label Text="SERVER INFO" StyleClasses="FSHeading" VAlign="Center" />
                                </BoxContainer>
                                <controls:HLine Color="#2E2E2E" Thickness="1" Margin="0 4 0 2" />
                                <info:ServerInfo Name="ServerInfo" Access="Public" VerticalExpand="True" />
                                <Label Name="StationTime" Access="Public" StyleClasses="FSTextDim" />
                            </BoxContainer>
                        </PanelContainer>
                        <!-- Character card (narrower — the other two take the freed space) -->
                        <PanelContainer StyleClasses="FSLobbyCard" HorizontalExpand="True" SizeFlagsStretchRatio="0.7">
                            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                    <TextureRect TexturePath="/Textures/Interface/character.svg.192dpi.png"
                                                 Stretch="KeepAspectCentered" SetSize="18 18" VerticalAlignment="Center" />
                                    <Label Text="CHARACTER" StyleClasses="FSHeading" VAlign="Center" />
                                </BoxContainer>
                                <controls:HLine Color="#2E2E2E" Thickness="1" Margin="0 4 0 2" />
                                <!-- Expanding spacers above/below vertically center the preview in the card -->
                                <BoxContainer Orientation="Vertical" VerticalExpand="True">
                                    <Control VerticalExpand="True" />
                                    <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public"
                                                                        HorizontalAlignment="Center" />
                                    <Control VerticalExpand="True" />
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <!-- Players card -->
                        <PanelContainer StyleClasses="FSLobbyCard" HorizontalExpand="True" SizeFlagsStretchRatio="1.15">
                            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                    <TextureRect TexturePath="/Textures/Interface/VerbIcons/group.svg.192dpi.png"
                                                 Stretch="KeepAspectCentered" SetSize="18 18" VerticalAlignment="Center" />
                                    <Label Name="PlayersHeader" Access="Public" Text="PLAYERS"
                                           StyleClasses="FSHeading" VAlign="Center" />
                                </BoxContainer>
                                <controls:HLine Color="#2E2E2E" Thickness="1" Margin="0 4 0 2" />
                                <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                                    <BoxContainer Name="PlayerRosterList" Access="Public" Orientation="Vertical"
                                                  SeparationOverride="2" />
                                </ScrollContainer>
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <!-- Bottom row: game mode blurb + chat -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalExpand="True"
                                  VerticalExpand="True" SizeFlagsStretchRatio="1" MinSize="0 200">
                        <PanelContainer StyleClasses="FSLobbyCard" SizeFlagsStretchRatio="1" HorizontalExpand="True">
                            <BoxContainer Orientation="Vertical" SeparationOverride="8">
                                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                    <TextureRect TexturePath="/Textures/_FinalStand/Interface/BattleTrance/skull.png"
                                                 Stretch="KeepAspectCentered" SetSize="18 18" VerticalAlignment="Center" />
                                    <Label Text="GAME MODE: FINAL STAND" StyleClasses="FSHeading" VAlign="Center" />
                                </BoxContainer>
                                <controls:HLine Color="#2E2E2E" Thickness="1" Margin="0 4 0 2" />
                                <BoxContainer Orientation="Horizontal" SeparationOverride="10" HorizontalExpand="True"
                                              VerticalExpand="True">
                                    <BoxContainer Orientation="Vertical" SeparationOverride="6"
                                                  HorizontalExpand="True" SizeFlagsStretchRatio="1"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200">
                                        <TextureRect TexturePath="/Textures/_FinalStand/Interface/Lobby/feature_survive.png"
                                                     Stretch="KeepAspectCentered" SetSize="44 44"
                                                     HorizontalAlignment="Center" Margin="0 4 0 0" />
                                        <Label Text="SURVIVE" StyleClasses="FSTextRed" HorizontalAlignment="Center" />
                                        <RichTextLabel Text="[color=#9A9A9A]Fight endless waves of enemies that get stronger over time.[/color]"
                                               HorizontalAlignment="Center" MaxWidth="200" />
                                    </BoxContainer>
                                    <PanelContainer StyleClasses="FSVDivider" MinSize="1 0" VerticalExpand="True" Margin="0 6" />
                                    <BoxContainer Orientation="Vertical" SeparationOverride="6"
                                                  HorizontalExpand="True" SizeFlagsStretchRatio="1"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200">
                                        <TextureRect TexturePath="/Textures/_FinalStand/Interface/Lobby/feature_defend.png"
                                                     Stretch="KeepAspectCentered" SetSize="44 44"
                                                     HorizontalAlignment="Center" Margin="0 4 0 0" />
                                        <Label Text="DEFEND" StyleClasses="FSTextGold" HorizontalAlignment="Center" />
                                        <RichTextLabel Text="[color=#9A9A9A]Protect the Central Command Console at all costs.[/color]"
                                               HorizontalAlignment="Center" MaxWidth="200" />
                                    </BoxContainer>
                                    <PanelContainer StyleClasses="FSVDivider" MinSize="1 0" VerticalExpand="True" Margin="0 6" />
                                    <BoxContainer Orientation="Vertical" SeparationOverride="6"
                                                  HorizontalExpand="True" SizeFlagsStretchRatio="1"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200">
                                        <TextureRect
                                            TexturePath="/Textures/_FinalStand/Interface/Lobby/feature_teamup.png"
                                            Stretch="KeepAspectCentered" SetSize="44 44"
                                            HorizontalAlignment="Center" Margin="0 4 0 0" />
                                        <Label Text="TEAM UP" StyleClasses="FSTextWhite" HorizontalAlignment="Center" />
                                        <RichTextLabel Text="[color=#9A9A9A]Work together, upgrade your augmentations.[/color]"
                                               HorizontalAlignment="Center" MaxWidth="200" />
                                    </BoxContainer>
                                    <PanelContainer StyleClasses="FSVDivider" MinSize="1 0" VerticalExpand="True" Margin="0 6" />
                                    <BoxContainer Orientation="Vertical" SeparationOverride="6"
                                                  HorizontalExpand="True" SizeFlagsStretchRatio="1"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="200">
                                        <TextureRect
                                            TexturePath="/Textures/_FinalStand/Interface/Lobby/feature_getstronger.png"
                                            Stretch="KeepAspectCentered" SetSize="44 44"
                                            HorizontalAlignment="Center" Margin="0 4 0 0" />
                                        <Label Text="GET STRONGER" StyleClasses="FSTextRed"
                                               HorizontalAlignment="Center" />
                                        <RichTextLabel Text="[color=#9A9A9A]Earn Augment Points, unlock powerful upgrades.[/color]"
                                               HorizontalAlignment="Center" MaxWidth="200" />
                                    </BoxContainer>
                                </BoxContainer>
                            </BoxContainer>
                        </PanelContainer>
                        <PanelContainer StyleClasses="FSLobbyCard" SizeFlagsStretchRatio="1.1" HorizontalExpand="True">
                            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" MinHeight="50" />
                        </PanelContainer>
                    </BoxContainer>
                    <!-- Very bottom row: Credits button + song / menu-art attribution beside it (left-aligned) -->
                    <BoxContainer Orientation="Horizontal" SeparationOverride="10" VerticalAlignment="Center">
                        <Button Name="CreditsButton" Text="CREDITS" />
                        <RichTextLabel Name="LobbySong" Access="Public" VerticalAlignment="Center" />
                        <RichTextLabel Name="LobbyBackground" Access="Public" VerticalAlignment="Center" />
                        <Control HorizontalExpand="True" />
                    </BoxContainer>
                    </BoxContainer>
                </BoxContainer>
                <TextureButton Name="CollapseButton"
                                TexturePath="filled_right_arrow.svg.192dpi"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0 2 2 0"
                                ModulateSelfOverride="#DEDEDE"
                                Scale="0.5 0.5"/>
            </PanelContainer>
        </SplitContainer>
        <PanelContainer Name="ExpandPanel"
                        StyleClasses="BackgroundPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 2 2 0"
                        Visible="False">
            <TextureButton Name="ExpandButton"
                        TexturePath="filled_left_arrow.svg.192dpi"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ModulateSelfOverride="#DEDEDE"
                        Scale="0.5 0.5"/>
        </PanelContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
