<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Weapon Shop"
                      Resizable="True"
                      SetSize="1100 740"
                      MinSize="900 680">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

        <PanelContainer Name="LeftPanel" SetWidth="410">
            <BoxContainer Orientation="Vertical" Margin="20" SeparationOverride="14">
                <LayoutContainer Name="Plate" SetHeight="160" HorizontalExpand="True">
                    <PanelContainer Name="PlateBg" />
                    <SpriteView Name="WeaponSprite" SetSize="144 144" Scale="4.5 4.5" OverrideDirection="South" />
                    <Label Name="PlateCategory" />
                    <PanelContainer Name="OwnedChip">
                        <Label Name="OwnedChipLabel" Margin="6 1" />
                    </PanelContainer>
                </LayoutContainer>

                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <Label Name="WeaponNameLabel" ClipText="True" HorizontalExpand="True" />
                    <RichTextLabel Name="DescLabel" MaxWidth="370" />
                </BoxContainer>

                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                    <BoxContainer Orientation="Horizontal">
                        <Label Name="ProgressTitle" Text="UPGRADE PROGRESS" HorizontalExpand="True" />
                        <Label Name="ProgressLabel" />
                    </BoxContainer>
                    <BoxContainer Name="ProgressBar" Orientation="Horizontal" SeparationOverride="2" />
                </BoxContainer>

                <GridContainer Name="StatBarsContainer" Columns="2" HSeparationOverride="8" VSeparationOverride="8" />

                <Control VerticalExpand="True" />
                <Button Name="BuyButton" MinHeight="42" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Button Name="SellButton" MinHeight="32" HorizontalExpand="True" />
                    <Button Name="KeepButton" Text="KEEP" MinHeight="32" Visible="False" />
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="20 16 20 0">
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 12">
                <Label Name="NotOwnedLabel" HorizontalExpand="True" ClipText="True" VerticalAlignment="Center" />
                <PanelContainer Name="BalanceChip">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Name="BalanceTitle" Text="BALANCE" VerticalAlignment="Center" />
                        <Label Name="BalanceLabel" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
            <ScrollContainer Name="UpgradesScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="UpgradesContainer" Orientation="Vertical" HorizontalExpand="True"
                              SeparationOverride="18" Margin="0 0 12 16" />
            </ScrollContainer>
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
