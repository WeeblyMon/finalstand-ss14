<widgets:AlertsUI xmlns="https://spacestation14.io"
                  xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Alerts.Widgets">
    <!-- FINALSTAND: a panelled strip sitting flush on top of the vitals block, rather than loose
         icons floating in the corner. Hidden entirely when there is nothing to show. -->
    <PanelContainer Name="AlertPanel" Access="Public"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Visible="False"
                    MinSize="240 0">
        <BoxContainer Name="AlertContainer" Access="Public"
                      Orientation="Horizontal"
                      HorizontalAlignment="Left" />
    </PanelContainer>
</widgets:AlertsUI>
