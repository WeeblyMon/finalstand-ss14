<controls:FSCasualtyBoardWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._FinalStand.MedicalOps"
    Title="{Loc 'fs-casualty-board-title'}"
    MinSize="420 260"
    SetSize="460 340">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="8">
        <Label Name="EmptyLabel"
               Text="{Loc 'fs-casualty-board-empty'}"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center"
               Margin="0 12 0 0" />
        <ScrollContainer VScrollEnabled="True" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="Entries" Access="Public" Orientation="Vertical" HorizontalExpand="True" />
        </ScrollContainer>
    </BoxContainer>
</controls:FSCasualtyBoardWindow>
