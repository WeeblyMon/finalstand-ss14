<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Armor Vendor"
    MinWidth="760" MinHeight="540">

    <BoxContainer Orientation="Vertical" Margin="10">

        <PanelContainer StyleClasses="FSCard" Margin="0 0 0 8">
            <BoxContainer Orientation="Horizontal" Margin="14 10">
                <Label Text="ARMOR VENDOR" StyleClasses="FSSectionHeader" VerticalAlignment="Center" />
                <Control HorizontalExpand="True" />
                <Label Text="CREDITS  " StyleClasses="FSMuted" VerticalAlignment="Center" />
                <Label Name="CreditsLabel" Text="$0" StyleClasses="FSCurrency" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" VerticalExpand="True">

            <PanelContainer StyleClasses="FSCard" MinWidth="286" Margin="0 0 8 0">
                <BoxContainer Orientation="Vertical" Margin="10">
                    <Label Text="SELECT ARMOR" StyleClasses="FSSectionHeader" Margin="0 0 0 6" />
                    <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="TierListContainer" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer StyleClasses="FSCard" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" Margin="14">

                    <BoxContainer Orientation="Horizontal" Margin="0 0 0 10">
                        <PanelContainer Name="PreviewPanel" MinSize="84 84" Margin="0 0 12 0">
                            <BoxContainer Name="PreviewContainer" Orientation="Vertical"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </PanelContainer>
                        <BoxContainer Orientation="Vertical" VerticalAlignment="Center" HorizontalExpand="True">
                            <Label Name="SelectedTierRank" Text="" StyleClasses="FSMuted" />
                            <Label Name="SelectedTierName" Text="—" StyleClasses="LabelHeading" />
                        </BoxContainer>
                    </BoxContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />

                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="StatsContainer" Orientation="Vertical" />
                    </ScrollContainer>

                    <PanelContainer StyleClasses="LowDivider" Margin="0 8 0 8" />

                    <BoxContainer Name="CostContainer" Orientation="Vertical" Margin="0 0 0 10" />

                    <Button Name="BuyButton" Text="BUY" Disabled="True" MinHeight="38" />
                </BoxContainer>
            </PanelContainer>

        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
