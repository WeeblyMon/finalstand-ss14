<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc 'fs-bag-shop-window-title'}"
    MinWidth="520" MinHeight="420"
    SetSize="520 420">

    <BoxContainer Orientation="Vertical" Margin="10">

        <PanelContainer StyleClasses="FSCard" Margin="0 0 0 8">
            <BoxContainer Orientation="Horizontal" Margin="14 10">
                <Label Text="{Loc 'fs-bag-shop-window-header'}" StyleClasses="FSSectionHeader" VerticalAlignment="Center" />
                <Control HorizontalExpand="True" />
                <Label Text="{Loc 'fs-bag-shop-window-credits'}" StyleClasses="FSMuted" VerticalAlignment="Center" />
                <Label Name="CreditsLabel" Text="$0" StyleClasses="FSCurrency" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <PanelContainer StyleClasses="FSCard" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10">
                <Label Text="{Loc 'fs-bag-shop-window-stock'}" StyleClasses="FSSectionHeader" Margin="0 0 0 6" />
                <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="EntryListContainer" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>

    </BoxContainer>
</DefaultWindow>
