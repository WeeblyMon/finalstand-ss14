<widgets:AlertsUI xmlns="https://spacestation14.io"
                  xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Alerts.Widgets">
    <!-- FINALSTAND: a vertical column growing upward from the vitals panel. Statuses and buffs are
         open-ended, so this must not be boxed to a fixed width - it shares the vitals panel's left
         edge for the visual tie instead of a wrapper. -->
    <BoxContainer Name="AlertContainer" Access="Public"
                  Orientation="Vertical"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom" />
</widgets:AlertsUI>
