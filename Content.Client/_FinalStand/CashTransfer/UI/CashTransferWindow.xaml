<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="{Loc 'fs-cash-transfer-window-title'}"
    MinWidth="260"
    MinHeight="155"
    Resizable="False">

    <BoxContainer Orientation="Vertical" Margin="10">

        <Label Name="ToLabel" Margin="0 0 0 2" />
        <Label Name="BalanceLabel" StyleClasses="FSCurrency" Margin="0 0 0 10" />

        <LineEdit Name="AmountInput" PlaceHolder="{Loc 'fs-cash-transfer-window-amount'}" />

        <BoxContainer Orientation="Horizontal" Margin="0 10 0 0">
            <Button Name="CancelButton" Text="{Loc 'fs-cash-transfer-window-cancel'}" HorizontalExpand="True" Margin="0 0 4 0" />
            <Button Name="ConfirmButton" Text="{Loc 'fs-cash-transfer-window-confirm'}" HorizontalExpand="True" />
        </BoxContainer>

    </BoxContainer>

</DefaultWindow>
