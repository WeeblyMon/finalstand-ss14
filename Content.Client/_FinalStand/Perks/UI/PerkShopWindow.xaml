<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:fsui="clr-namespace:Content.Client._FinalStand.UI"
                      Title="{Loc 'fs-perk-shop-title'}"
                      Resizable="True"
                      SetSize="1060 700"
                      MinSize="760 600">
    <TabContainer Name="ShopTabs" VerticalExpand="True">

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

            <PanelContainer Name="HeaderPanel">
                <BoxContainer Orientation="Horizontal" Margin="20 12">
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                        <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
                            <Label Name="EquippedTitle" Text="{Loc 'fs-perk-shop-equipped'}" Margin="0 0 8 0" />
                            <Label Name="EquippedCountLabel" Text="0 / 6" />
                            <Label Name="ArchetypeLabel" Margin="14 0 0 0" />
                        </BoxContainer>
                        <BoxContainer Name="SlotsRow" Orientation="Horizontal" SeparationOverride="8" />
                    </BoxContainer>
                    <Control HorizontalExpand="True" />
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                            <Label Name="PpLabel" Text="0" Margin="0 0 6 0" />
                            <Label Name="PpUnitLabel" Text="{Loc 'fs-perk-shop-pp-unit'}" VerticalAlignment="Bottom" Margin="0 0 0 3" />
                        </BoxContainer>
                        <Label Name="InvestedLabel" Text="" HorizontalAlignment="Right" />
                        <Button Name="StarterBuildsButton" HorizontalAlignment="Right" MinHeight="26" Margin="0 6 0 0" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer Name="StarterBanner" Visible="False">
                <BoxContainer Orientation="Horizontal" Margin="20 8" SeparationOverride="12">
                    <Label Name="StarterBannerLabel" VerticalAlignment="Center" HorizontalExpand="True" />
                    <Button Name="StarterBannerButton" MinHeight="30" />
                </BoxContainer>
            </PanelContainer>

            <BoxContainer Name="BodyBox" Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="20 14 20 0">
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="0 0 0 12">
                        <Button Name="FilterAll"    Text="{Loc 'fs-perk-shop-filter-all'}"        ToggleMode="True" />
                        <Button Name="FilterRed"    Text="{Loc 'fs-perk-shop-category-offense'}" ToggleMode="True" />
                        <Button Name="FilterBlue"   Text="{Loc 'fs-perk-shop-category-defense'}" ToggleMode="True" />
                        <Button Name="FilterGreen"  Text="{Loc 'fs-perk-shop-category-utility'}" ToggleMode="True" />
                        <Button Name="FilterYellow" Text="{Loc 'fs-perk-shop-category-economy'}" ToggleMode="True" />
                        <Button Name="FilterPurple" Text="{Loc 'fs-perk-shop-category-hybrid'}"  ToggleMode="True" />
                        <Control HorizontalExpand="True" />
                        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'fs-perk-shop-search'}" SetWidth="200" />
                    </BoxContainer>
                    <ScrollContainer Name="PerkScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="PerkGrid" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="18" Margin="0 0 0 16" />
                    </ScrollContainer>
                </BoxContainer>

                <PanelContainer Name="DetailPanel">
                    <BoxContainer Name="DetailBox" Orientation="Vertical" Margin="18" SeparationOverride="14">
                        <BoxContainer Name="InfoBox" Orientation="Vertical" SeparationOverride="12">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="14">
                                <PanelContainer Name="SelectedIconBox" SetSize="84 84">
                                    <fsui:FSMipmapRect Name="SelectedPerkIcon" SetSize="60 60"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </PanelContainer>
                                <BoxContainer Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="6">
                                    <Label Name="SelectedNameLabel" Text="" />
                                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                                        <PanelContainer Name="CategoryTag">
                                            <Label Name="SelectedCategoryLabel" Text="" Margin="6 1" />
                                        </PanelContainer>
                                        <Label Name="SelectedLevelLabel" Text="" />
                                    </BoxContainer>
                                </BoxContainer>
                            </BoxContainer>
                            <RichTextLabel Name="SelectedDescLabel" />
                        </BoxContainer>
                        <BoxContainer Name="ActionsBox" Orientation="Vertical" VerticalExpand="True" SeparationOverride="8">
                            <ScrollContainer Name="LevelEffectsScroll" VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                                <BoxContainer Name="LevelEffectsBox" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4" />
                            </ScrollContainer>
                            <Label Name="ShortfallLabel" Text="" Visible="False" />
                            <Button Name="UpgradeButton" MinHeight="42" />
                            <Button Name="EquipButton" MinHeight="38" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

            </BoxContainer>

            <PanelContainer Name="FooterPanel">
                <BoxContainer Orientation="Horizontal" Margin="20 8" SeparationOverride="10">
                    <Label Name="LoadoutsTitle" Text="{Loc 'fs-perk-shop-loadouts'}" VerticalAlignment="Center" Margin="0 0 6 0" />
                    <BoxContainer Name="LoadoutRow" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="8" />
                    <Button Name="RespecButton" Text="{Loc 'fs-perk-shop-respec'}" VerticalAlignment="Center" MinHeight="32" />
                </BoxContainer>
            </PanelContainer>

        </BoxContainer>

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="16">

            <Label Name="PrestigeLevelLabel" StyleClasses="LabelHeading" Margin="0 0 0 8" />
            <Label Name="PrestigeXpBonusLabel" Margin="0 0 0 4" />
            <Label Name="PrestigeRequirementLabel" StyleClasses="FSMuted" Margin="0 0 0 16" />
            <Button Name="PrestigeButton" Text="{Loc 'fs-perk-shop-prestige-button'}" Disabled="True" SetHeight="40" Margin="0 0 0 20" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 10" />

            <Label Text="{Loc 'fs-perk-shop-prestige-history'}" StyleClasses="FSSectionHeader" Margin="0 0 0 6" />
            <!-- // TODO(finalstand): populate prestige history -->
            <Label Name="PrestigeHistoryLabel" Text="{Loc 'fs-perk-shop-prestige-history-empty'}" StyleClasses="FSMuted" />

        </BoxContainer>

    </TabContainer>
</controls:FancyWindow>
