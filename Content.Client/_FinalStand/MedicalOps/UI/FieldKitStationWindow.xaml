<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Field Kit Station"
                      Resizable="True"
                      SetSize="1180 720"
                      MinSize="1040 620">
    <TabContainer Name="Tabs" HorizontalExpand="True" VerticalExpand="True">

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer Name="LoadoutStrip">
                <BoxContainer Orientation="Horizontal" MinHeight="88" Margin="20 0" SeparationOverride="16">
                    <BoxContainer Orientation="Vertical" SetWidth="260" VerticalAlignment="Center" SeparationOverride="4">
                        <Label Name="LauncherTitle" Text="CHEM LAUNCHER" />
                        <Label Name="LauncherLabel" />
                        <BoxContainer Name="ReserveBar" Orientation="Horizontal" SetHeight="8" />
                        <Label Name="ReserveHint" />
                    </BoxContainer>
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center" SeparationOverride="6">
                        <Label Name="SlotsTitle" Text="SLOTS" />
                        <BoxContainer Name="SlotRow" Orientation="Horizontal" SeparationOverride="6" />
                    </BoxContainer>
                    <Control HorizontalExpand="True" />
                    <BoxContainer Orientation="Vertical" SetWidth="220" VerticalAlignment="Center" SeparationOverride="4">
                        <Label Name="TonicTitle" Text="WAVE TONIC" />
                        <Button Name="TonicButton" MinHeight="40" />
                        <Label Name="TonicHint" />
                    </BoxContainer>
                </BoxContainer>
            </PanelContainer>
            <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                <GridContainer Name="FormulaGrid" Columns="3" HSeparationOverride="12" VSeparationOverride="12" Margin="16" />
            </ScrollContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer Name="RawStrip">
                    <BoxContainer Orientation="Horizontal" MinHeight="64" Margin="20 0" SeparationOverride="12">
                        <LineEdit Name="SearchBox" PlaceHolder="Search reagents" SetWidth="260" VerticalAlignment="Center" />
                        <Control HorizontalExpand="True" />
                        <Label Name="AmountTitle" Text="DISPENSE" VerticalAlignment="Center" />
                        <BoxContainer Name="AmountRow" Orientation="Horizontal" SeparationOverride="4" VerticalAlignment="Center" />
                    </BoxContainer>
                </PanelContainer>
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                    <BoxContainer Name="RawGroups" Orientation="Vertical" SeparationOverride="18" Margin="16" />
                </ScrollContainer>
                <PanelContainer Name="PackStrip">
                    <BoxContainer Orientation="Horizontal" Margin="16 12" SeparationOverride="12">
                        <BoxContainer Name="PackRow" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="12" />
                        <BoxContainer Orientation="Vertical" SetWidth="220" SeparationOverride="6">
                            <Label Name="LabelTitle" Text="LABEL" />
                            <LineEdit Name="LabelEdit" PlaceHolder="Bottles and pills" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <PanelContainer Name="Sidebar" SetWidth="290">
                <BoxContainer Orientation="Vertical" Margin="16" SeparationOverride="12">
                    <BoxContainer Orientation="Horizontal">
                        <Label Name="JugTitle" Text="JUG" HorizontalExpand="True" />
                        <Label Name="JugLabel" />
                    </BoxContainer>
                    <BoxContainer Name="JugBar" Orientation="Horizontal" SetHeight="12" />
                    <BoxContainer Name="JugRows" Orientation="Vertical" SeparationOverride="4" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Button Name="EmptyButton" Text="EMPTY" MinHeight="32" HorizontalExpand="True" />
                        <Button Name="EjectButton" Text="EJECT" MinHeight="32" HorizontalExpand="True" />
                    </BoxContainer>
                    <PanelContainer Name="ContextPanel" VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" Margin="12 10" SeparationOverride="6">
                            <Label Name="ContextTitle" Text="THE JUG CAN MAKE" />
                            <BoxContainer Name="ContextBody" Orientation="Vertical" SeparationOverride="4" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

    </TabContainer>
</controls:FancyWindow>
