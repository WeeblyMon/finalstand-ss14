<Project>
  <!--
  Content specific properties
  Import *before* Robust.Properties.targets
  -->

  <PropertyGroup>
    <LangVersion Condition="'$(LangVersion)' == ''">14</LangVersion>
    <IsPackable Condition="'$(IsPackable)' == ''">false</IsPackable>
    <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0672;CS0169;CS0414;NU1510;NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- RA0049/RA0051: engine 288 wants [Dependency] fields non-readonly on partial types.
         Upstream migrated its own files; the fork has not. Deferred, not fixed. -->
    <WarningsNotAsErrors>CS0618,CS0672,CS0612,CS1062,CS1064,NU1900,NU1901,NU1902,NU1903,NU1904,RA0049,RA0051</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
