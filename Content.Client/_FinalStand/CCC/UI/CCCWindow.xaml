<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:map="clr-namespace:Content.Client.Pinpointer.UI"
                      xmlns:power="clr-namespace:Content.Client.Power"
                      Title="Central Command Console"
                      Resizable="False"
                      SetSize="1040 750"
                      MinSize="1040 750">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

        <!-- LEFT: fixed-width CCC info panel -->
        <BoxContainer Orientation="Vertical" Margin="10" SetWidth="340" VerticalExpand="True">

            <!-- Wave Intel -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <Label Text="WAVE " Modulate="#7EB8D4" />
                <Label Name="WaveNumberLabel" Modulate="#F4C430" />
                <Label Text="   " />
                <Label Name="FactionLabel" Modulate="#FF6666" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 2">
                <Label Text="Modifier: " Modulate="#888888" />
                <Label Name="ModifierLabel" Modulate="#AAAAFF" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <Label Text="Est. enemies: " Modulate="#888888" />
                <Label Name="EnemyEstLabel" Modulate="#FF8A65" />
            </BoxContainer>
            <BoxContainer Name="ZombieIconsContainer" Orientation="Vertical" Margin="0 0 0 8" Visible="False" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />

            <!-- Phase + Countdown -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 2">
                <Label Text="Phase: " Modulate="#888888" />
                <Label Name="PhaseLabel" />
                <Label Text="   " />
                <Label Name="CountdownLabel" StyleClasses="LabelMonospaceText" Modulate="#AAFFAA" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
                <Label Text="Alive: " Modulate="#888888" />
                <Label Name="AliveLabel" />
                <Label Text=" / " Modulate="#555555" />
                <Label Name="TotalLabel" />
                <Label Text="   Spawners: " Modulate="#888888" />
                <Label Name="SpawnersLabel" />
            </BoxContainer>

            <!-- CCC Health -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 8">
                <Label Text="CCC: " Modulate="#888888" />
                <Label Name="CCCHealthLabel" Modulate="#AAFFAA" />
            </BoxContainer>

            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />

            <!-- Player Readiness -->
            <Label Text="READINESS" StyleClasses="LabelHeading" Modulate="#7EB8D4" Margin="0 0 0 4" />
            <Label Name="ReadinessLabel" Modulate="#AAFFAA" Margin="0 0 0 8" />

            <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />

            <!-- Controls -->
            <Button Name="StartWaveButton" Text="Start Wave Now" StyleClasses="ButtonBig" Margin="0 0 0 6" />
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 4">
                <LineEdit Name="BroadcastInput" HorizontalExpand="True" PlaceHolder="Command broadcast..." />
                <Button Name="BroadcastButton" Text="Send" SetWidth="60" Margin="4 0 0 0" />
            </BoxContainer>

        </BoxContainer>

        <!-- Vertical separator -->
        <PanelContainer StyleClasses="LowDivider" Margin="0 8" />

        <!-- RIGHT: map panel -->
        <BoxContainer Orientation="Vertical" Margin="8 10 10 10" HorizontalExpand="True" VerticalExpand="True">

            <!-- Toggle buttons — OpenRight/OpenLeft give a connected tab-group appearance -->
            <BoxContainer Orientation="Horizontal" Margin="0 0 0 6">
                <Button Name="MapViewButton" Text="MAP" StyleClasses="OpenRight" HorizontalExpand="True" />
                <Button Name="PowerViewButton" Text="POWER" StyleClasses="OpenLeft" HorizontalExpand="True" />
            </BoxContainer>

            <!-- Station map view (default) -->
            <!-- TODO(finalstand): 1px #2A2A3A border around map — requires PanelContainer wrapper, skip to avoid restructuring -->
            <BoxContainer Name="MapPanel" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <map:NavMapControl Name="CccNavMap" />
            </BoxContainer>

            <!-- Power monitoring view (hidden by default) -->
            <BoxContainer Name="PowerPanel" Orientation="Vertical" Visible="False" VerticalExpand="True" HorizontalExpand="True">
                <power:PowerMonitoringConsoleNavMapControl Name="CccPowerMap" />
            </BoxContainer>

        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
