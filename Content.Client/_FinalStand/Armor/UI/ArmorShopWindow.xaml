<DefaultWindow
    xmlns="https://spacestation14.io"
    Title="Armor Vendor"
    MinWidth="600" MinHeight="420">

    <BoxContainer Orientation="Horizontal" Margin="10">

        <!-- LEFT: tier selection list -->
        <PanelContainer StyleClasses="FSCard" MinWidth="272" Margin="0 0 10 0">
            <BoxContainer Orientation="Vertical" Margin="10">
                <Label Text="SELECT ARMOR" StyleClasses="FSSectionHeader" Margin="0 0 0 6" />
                <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="TierListContainer" Orientation="Vertical" />
                </ScrollContainer>
            </BoxContainer>
        </PanelContainer>

        <!-- RIGHT: selected tier stats + buy -->
        <PanelContainer StyleClasses="FSCard" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10">
                <Label Name="SelectedTierName" Text="—" StyleClasses="LabelHeading" Margin="0 0 0 6" />
                <PanelContainer StyleClasses="LowDivider" Margin="0 0 0 8" />
                <BoxContainer Name="StatsContainer" Orientation="Vertical" VerticalExpand="True" />
                <Button Name="BuyButton" Text="BUY" Disabled="True" Margin="0 10 0 0" />
            </BoxContainer>
        </PanelContainer>

    </BoxContainer>
</DefaultWindow>
